# Required
GROQ_API_KEY=your_groq_key_here
# Optional (enables live web search; without it the system runs on your PDFs only)
SERPER_API_KEY=your_serper_key_here

# Models (LiteLLM naming used by CrewAI)
MODEL_SMART=groq/llama-3.3-70b-versatile
MODEL_FAST=groq/llama-3.1-8b-instant

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=./data/chroma
K_WEB=4
K_PDF=4
PDF_MIN_SCORE=0.30
FETCH_PAGES=true

# Research loop
MAX_ITERATIONS=2
MAX_SUBQUESTIONS=4
SUFFICIENCY_SCORE=8
